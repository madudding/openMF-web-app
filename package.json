
{
  "name": "mifosx-web-app",
  "version": "1.0.0",
  "description": "MifosX Web App is the default web application built on top of the Fineract platform for the Mifos user community leveraging the popular Angular framework.",
  "keywords": [
    "mifos",
    "openmf",
    "fineract",
    "angular"
  ],
  "homepage": "https://github.com/openMF/web-app",
  "license": "MPL-2.0",
  "scripts": {
    "prepare": "husky",
    "ng": "ng",
    "build": "node version.js && npm run env -s && ng build --configuration production --output-hashing=none",
    "build:prod": "node version.js && node --max-old-space-size=16384 ./node_modules/@angular/cli/bin/ng build --configuration production --output-hashing=none --base-href=/web-app/",
    "start": "npm run env -s && ng serve --aot --proxy-config proxy.conf.js",
    "serve:dev": "npm run env -s && ng serve --source-map",
    "serve:sw": "npm run build -s && npx http-server ./dist -p 4200",
    "lint": "eslint . && stylelint \"src/**/*.scss\" && prettier . --check && htmlhint \"src\" --config .htmlhintrc",
    "test": "jest",
    "test:ci": "npm run env -s && npm run lint -s && ng test --code-coverage --watch=false",
    "test:watch": "ng test --watch",
    "e2e": "ng e2e",
    "translations:extract": "ngx-translate-extract --input ./src --output ./src/translations/template.json --format=json --clean -sort --marker extract",
    "env": "node version.js",
    "postinstall": "node version.js",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "dependencies": {
    "@angular-devkit/schematics": "^17.0.0",
    "@angular/animations": "^17.0.0",
    "@angular/cdk": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/localize": "^17.0.0",
    "@angular/material": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@ckeditor/ckeditor5-angular": "^7.0.1",
    "@ckeditor/ckeditor5-build-classic": "^39.0.2",

    "@fortawesome/fontawesome-free": "^6.5.2",
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-brands-svg-icons": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/angular-fontawesome": "^0.14.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "ts-node": "^10.9.2",
    "@tailwindcss/forms": "^0.5.4",
    "chart.js": "^4.4.3",
    "d3": "^7.9.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lodash": "4.17.21",
    "moment": "^2.30.1",
    "ngx-mat-select-search": "^8.0.0",
    "rxjs": "7.8.1",
    "tslib": "^2.6.2",
    "vkbeautify": "^0.99.3",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^17.0.0",
    "@angular-eslint/eslint-plugin": "^17.0.0",
    "@angular-eslint/eslint-plugin-template": "^17.0.0",
    "@angular-eslint/schematics": "^17.0.0",
    "@angular-eslint/template-parser": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@angular/language-service": "^17.0.0",
    "@cypress/schematic": "^3.0.0",
    "@types/d3-dispatch": "^3.0.2",
    "@types/d3-drag": "^3.0.2",
    "@types/d3-scale": "^3.2.3",
    "@types/d3-shape": "^3.1.1",
    "@types/d3-timer": "^3.0.1",
    "@types/jasminewd2": "^2.0.10",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.12.12",
    "@types/vkbeautify": "^0.99.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vendure/ngx-translate-extract": "^9.4.0",
    "cypress": "^13.7.3",
    "eslint": "^8.57.0",
    "git-describe": "^4.0.4",
    "htmlhint": "^1.2.0",
    "https-proxy-agent": "^7.0.2",
    "husky": "^9.0.11",
    "jasmine-core": "^5.1.1",
    "jasmine-spec-reporter": "^7.0.0",
    "jest": "^29.0.0",
    "jest-preset-angular": "^14.1.2",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-multiline-arrays": "^3.0.6",
    "puppeteer": "^22.0.0",
    "stylelint": "^16.10.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-scss": "^6.8.1",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openMF/web-app.git"
  },
  "bugs": {
    "url": "https://mifosforge.jira.com/jira/software/c/projects/WEB/boards/62"
  },
  "engines": {
    "node": ">= 24.4.1",
    "npm": ">= 10.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache",
    "*.{css,scss}": "stylelint",
    "*": "prettier --check --ignore-unknown"
  },
  "overrides": {
    "exceljs": {
      "archiver": "^7.0.1",
      "unzipper": "^0.12.3"
    }
  }
}
